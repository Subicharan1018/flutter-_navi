# NaviVibe web app on subiserver: Caddy (Docker) on 127.0.0.1:8090 only; the
# Cloudflare Tunnel publishes it as https://subimusic.me and does the TLS.
# Installed to /opt/navivibe-web/Caddyfile by tool/web/server/deploy-web.sh.
{
	admin off
	auto_https off
	servers {
		# cloudflared is the only client.
		trusted_proxies static 127.0.0.1/32 ::1
	}
}

# Any Host: cloudflared forwards the visitor's Host (subimusic.me), and a site
# address of 127.0.0.1 would match none of them (Caddy answers an empty 200).
# `bind` still keeps it on loopback only.
http://:8090 {
	bind 127.0.0.1

	# Navidrome on the same origin: no CORS for the web app, and the Android and
	# Windows apps that use https://subimusic.me as their server keep working.
	# The Navidrome admin UI (/app) is not here; it is on navidrome.subimusic.me.
	@navidrome path /rest/* /auth/* /api/* /share/*
	handle @navidrome {
		reverse_proxy 127.0.0.1:4533
	}

	handle {
		# "current" is a symlink to releases/<build>; deploy-web.sh flips it with
		# an atomic rename, and Caddy follows it per request.
		root * /srv/navivibe-web/current
		encode zstd gzip
		try_files {path} /index.html
		file_server

		header {
			X-Content-Type-Options nosniff
			Referrer-Policy same-origin
			X-Frame-Options DENY
			Permissions-Policy "camera=(self), microphone=(self), geolocation=(), usb=()"
			Strict-Transport-Security "max-age=31536000"
			Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://navidrome.subimusic.me; media-src 'self' blob: https://navidrome.subimusic.me; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://navidrome.subimusic.me https://shuffle.subimusic.me https://session.subimusic.me wss://session.subimusic.me https://fonts.gstatic.com; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
		}

		# What decides which build a visitor runs: always revalidated (ETag makes an
		# unchanged file a cheap 304).
		@revalidate path / /index.html /flutter_bootstrap.js /flutter.js /flutter_service_worker.js /sw.js /version.json /manifest.json /main.dart.js /main.dart.mjs /main.dart.wasm
		header @revalidate Cache-Control "no-cache"
		# Flutter's output has no content-hashed file names (the engine, fonts and
		# icons keep the same URL across builds), so nothing can be "immutable"
		# safely; a day, and the service worker re-fetches them per build.
		@daily path /canvaskit/* /assets/* /icons/* /favicon.png /sqlite3.wasm /drift_worker.js
		header @daily Cache-Control "public, max-age=86400"
		@sw path /sw.js
		header @sw Service-Worker-Allowed "/"
	}

	log {
		output stdout
		# Subsonic URLs carry t/s/p or jwt in the query string: never log them.
		format filter {
			wrap console
			fields {
				request>uri query {
					replace t REDACTED
					replace s REDACTED
					replace p REDACTED
					replace jwt REDACTED
					replace token REDACTED
				}
			}
		}
	}
}
