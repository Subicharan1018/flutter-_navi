# NaviVibe web app on this Windows machine: Caddy on 127.0.0.1:8090, published
# as https://subimusic.me by a Cloudflare Tunnel (docs/web-deploy.md).
# deploy-web.ps1 copies this to %LOCALAPPDATA%\NaviVibeWeb\Caddyfile and writes
# active.caddy next to it (the live release folder), then reloads Caddy; a
# reload swaps the config atomically, so a deploy never serves half a build.
{
	# Loopback admin API: only deploy-web.ps1's `caddy reload` uses it.
	admin localhost:2019
	auto_https off
	servers {
		trusted_proxies static 127.0.0.1/32 ::1
	}
}

http://127.0.0.1:8090 {
	bind 127.0.0.1

	# Navidrome on the same origin, so the web app needs no CORS for it and the
	# apps that use https://subimusic.me as their server keep working. Over
	# Tailscale to subiserver by default; set NAVIDROME_UPSTREAM to change it.
	@navidrome path /rest/* /auth/* /api/* /share/*
	handle @navidrome {
		reverse_proxy {$NAVIDROME_UPSTREAM:100.99.105.51:4533}
	}

	handle {
		# root * "<live release>", written by deploy-web.ps1
		import active.caddy
		encode zstd gzip
		try_files {path} /index.html
		file_server

		header {
			X-Content-Type-Options nosniff
			Referrer-Policy same-origin
			X-Frame-Options DENY
			Permissions-Policy "camera=(self), microphone=(self), geolocation=(), usb=()"
			Strict-Transport-Security "max-age=31536000"
			Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://navidrome.subimusic.me; media-src 'self' blob: https://navidrome.subimusic.me; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://navidrome.subimusic.me https://shuffle.subimusic.me https://session.subimusic.me wss://session.subimusic.me https://fonts.gstatic.com; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
		}

		# What decides which build a visitor runs: always revalidated (ETag, so an
		# unchanged file is a cheap 304). Flutter's file names carry no content
		# hash, so the app code is revalidated too rather than cached for long.
		@revalidate path / /index.html /flutter_bootstrap.js /flutter.js /flutter_service_worker.js /sw.js /version.json /manifest.json /main.dart.js /main.dart.mjs /main.dart.wasm
		header @revalidate Cache-Control "no-cache"
		# Engine, fonts, icons, sqlite: same name across builds, so a day, not a
		# year; the service worker re-fetches them for each new build anyway.
		@daily path /canvaskit/* /assets/* /icons/* /favicon.png /sqlite3.wasm /drift_worker.js
		header @daily Cache-Control "public, max-age=86400"
		@sw path /sw.js
		header @sw Service-Worker-Allowed "/"
	}

	log {
		output file {$LOCALAPPDATA}/NaviVibeWeb/access.log {
			roll_size 10MiB
			roll_keep 3
		}
		# Subsonic URLs carry t/s/p or jwt in the query string: never log them.
		format filter {
			wrap console
			fields {
				request>uri query {
					replace t REDACTED
					replace s REDACTED
					replace p REDACTED
					replace jwt REDACTED
					replace token REDACTED
				}
			}
		}
	}
}
